# Serves the app over HTTPS with a certificate from Caddy's own local CA.
# Tablets must trust that CA once: copy /data/caddy/pki/authorities/local/root.crt
# out of the caddy-data volume and install it on the device.
{
	local_certs
	skip_install_trust
}

https://{$POS_LAN_HOST}:443 {
	tls internal
	reverse_proxy app:8080
}
